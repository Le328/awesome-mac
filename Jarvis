import datetime
import webbrowser
import pyttsx3
import speech_recognition as sr

engine = pyttsx3.init()
engine.setProperty("rate", 175)

def sprich(text):
    print("Jarvis:", text)
    engine.say(text)
    engine.runAndWait()

def zuhoeren():
    r = sr.Recognizer()
    with sr.Microphone() as quelle:
        r.adjust_for_ambient_noise(quelle, duration=0.5)
        audio = r.listen(quelle, phrase_time_limit=6)
    try:
        return r.recognize_google(audio, language="de-DE").lower()
    except sr.UnknownValueError:
        return ""

def befehl_ausfuehren(text):
    if "uhrzeit" in text or "wie spät" in text:
        sprich("Es ist " + datetime.datetime.now().strftime("%H:%M") + " Uhr.")
    elif "guetta" in text:
        sprich("Wird gemacht, Sir.")
        webbrowser.open("https://www.youtube.com/results?search_query=david+guetta")
    elif "öffne google" in text:
        webbrowser.open("https://www.google.com")
    elif "suche" in text:
        suche = text.split("suche", 1)[1].strip()
        webbrowser.open("https://www.google.com/search?q=" + suche)
    elif "beenden" in text or "tschüss" in text:
        sprich("Bis später, Sir.")
        return False
    else:
        sprich("Das habe ich nicht verstanden.")
    return True

sprich("Jarvis ist online. Wie kann ich helfen?")
laeuft = True
while laeuft:
    gehoert = zuhoeren()
    if "jarvis" in gehoert:
        laeuft = befehl_ausfuehren(gehoert.replace("jarvis", "").strip())
